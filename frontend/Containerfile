# Build stage
FROM oven/bun:1 AS builder

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

# Serve stage - nginx with API proxying to hub
FROM nginxinc/nginx-unprivileged:alpine

LABEL org.opencontainers.image.source="https://github.com/dadav/rhacs-manager" \
      org.opencontainers.image.description="RHACS CVE Manager Frontend" \
      org.opencontainers.image.licenses="Apache-2.0"

# Upgrade base packages to pick up Alpine security fixes not yet in the
# upstream image (e.g. brotli-libs for CVE-2026-111497), then install envsubst
USER root
RUN apk upgrade --no-cache && apk add --no-cache gettext
USER 101

# Copy built SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx template (envsubst will process it at startup)
COPY nginx.conf.spoke /etc/nginx/templates/default.conf.template

# Copy entrypoint script
COPY docker-entrypoint-spoke.sh /docker-entrypoint.sh
USER root
RUN chmod +x /docker-entrypoint.sh
USER 101

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
