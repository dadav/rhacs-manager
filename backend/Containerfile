FROM python:3.14-slim@sha256:930e1abba7c4e8f96ed93e8012c35d174d7732752731bbd5e8e757d7ec6f3966

LABEL org.opencontainers.image.source="https://github.com/dadav/rhacs-manager" \
      org.opencontainers.image.description="RHACS CVE Manager Backend" \
      org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app

ENV UV_CACHE_DIR=/tmp/uv-cache

# Pull Debian security fixes published after the base image digest was built.
# pip is removed because dependencies are installed and run with uv only.
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip uninstall -y pip

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /uvx /usr/local/bin/

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock ./

# Install dependencies (no editable, no dev deps)
RUN uv sync --frozen --no-dev --no-editable && \
    chgrp -R 0 /tmp/uv-cache && chmod -R g=u /tmp/uv-cache

# Copy application code
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini ./
# Run migrations then start server
CMD ["sh", "-c", "uv run --no-dev --offline --no-sync alembic upgrade head && uv run --no-dev --offline --no-sync uvicorn app.main:app --host 0.0.0.0 --port 8000"]
