{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:earlyMondays"],
  "bumpVersion": "patch",
  "prHourlyLimit": 4,
  "packageRules": [
    {
      "description": "Automerge minor, patch, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ],
  "hostRules": [
    {
      "matchHost": "registry.redhat.io",
      "username": "{{ secrets.REDHAT_USERNAME }}",
      "password": "{{ secrets.REDHAT_TOKEN }}"
    }
  ]
}
