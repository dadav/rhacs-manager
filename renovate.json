{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:earlyMondays"],
  "bumpVersion": "patch",
  "prHourlyLimit": 4,
  "packageRules": [
    {
      "description": "Automerge minor, patch, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Do not update the ose-oauth-proxy image",
      "matchPackageNames": ["registry.redhat.io/openshift4/ose-oauth-proxy"],
      "enabled": false
    },
    {
      "description": "Do not update fastapi to >= 0.137 (pinned in backend/pyproject.toml)",
      "matchPackageNames": ["fastapi"],
      "allowedVersions": "<0.137"
    }
  ]
}
